<div style="display: flex; align-items: center; justify-content: center; min-height: 80vh;">
  <div style="background: #9ca3af; padding: 3rem 4rem; border-radius: 16px; text-align: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);">
    <h1 style="font-size: 2.5rem; color: #1f2937; margin: 0;">
      {@mensagem}, {format_name(@name)}!
    </h1>
    <p style="font-size: 3rem; margin: 1rem 0 0;">👋</p>
  </div>
</div>